// =====================================================================
// DAX MEASURES  |  Create a table "_Measures" (Enter Data -> blank) and add these
// Model: fact_orders[DateKey] -> dim_date[DateKey] (many-to-one)
//        fact_orders[CustomerID] -> dim_customer[CustomerID]
//        fact_orders[ProductID]  -> dim_product[ProductID]
// dim_date must be marked as Date table (Table tools -> Mark as date table -> Date)
// Net Sales / Profit columns already contain 0 for invalid sales (cancelled, returned, failed payment)
// =====================================================================

// ---------- CORE ----------
Net Sales = SUM ( fact_orders[NetSales] )
Gross Sales = CALCULATE ( SUM ( fact_orders[GrossSales] ), fact_orders[IsValidSale] = 1 )
Total Discount = CALCULATE ( SUM ( fact_orders[DiscountAmount] ), fact_orders[IsValidSale] = 1 )
Total Cost = CALCULATE ( SUM ( fact_orders[TotalCost] ), fact_orders[IsValidSale] = 1 )
Profit = SUM ( fact_orders[Profit] )
Profit Margin % = DIVIDE ( [Profit], [Net Sales] )
Discount % = DIVIDE ( [Total Discount], [Gross Sales] )
Total Orders = CALCULATE ( DISTINCTCOUNT ( fact_orders[OrderID] ), fact_orders[IsValidSale] = 1 )
Units Sold = CALCULATE ( SUM ( fact_orders[Quantity] ), fact_orders[IsValidSale] = 1 )
Average Order Value = DIVIDE ( [Net Sales], [Total Orders] )

// ---------- LEAKAGE ----------
Lost Sales (Cancel/Return/Failed) = CALCULATE ( SUM ( fact_orders[NetSalesRaw] ), fact_orders[IsValidSale] = 0 )
Leakage % = DIVIDE ( [Lost Sales (Cancel/Return/Failed)], SUM ( fact_orders[NetSalesRaw] ) )

// ---------- CUSTOMERS ----------
Total Customers =
CALCULATE ( DISTINCTCOUNT ( fact_orders[CustomerID] ), fact_orders[IsValidSale] = 1 )

Repeat Customers =
VAR _t =
    ADDCOLUMNS (
        VALUES ( fact_orders[CustomerID] ),
        "@orders", CALCULATE ( DISTINCTCOUNT ( fact_orders[OrderID] ), fact_orders[IsValidSale] = 1 )
    )
RETURN COUNTROWS ( FILTER ( _t, [@orders] >= 2 ) )

Repeat Customer Rate % = DIVIDE ( [Repeat Customers], [Total Customers] )
Avg Revenue per Customer = DIVIDE ( [Net Sales], [Total Customers] )
Avg Orders per Customer = DIVIDE ( [Total Orders], [Total Customers] )

// ---------- TIME INTELLIGENCE ----------
Net Sales PM = CALCULATE ( [Net Sales], DATEADD ( dim_date[Date], -1, MONTH ) )
Net Sales MoM % = DIVIDE ( [Net Sales] - [Net Sales PM], [Net Sales PM] )

Net Sales PY = CALCULATE ( [Net Sales], SAMEPERIODLASTYEAR ( dim_date[Date] ) )
Net Sales YoY % = DIVIDE ( [Net Sales] - [Net Sales PY], [Net Sales PY] )

Net Sales YTD = TOTALYTD ( [Net Sales], dim_date[Date] )

// KPI cards "vs previous period" (works for any date slicer range: compares with the same-length period before)
Net Sales Prev Period =
VAR _days = DATEDIFF ( MIN ( dim_date[Date] ), MAX ( dim_date[Date] ), DAY ) + 1
RETURN CALCULATE ( [Net Sales], DATEADD ( dim_date[Date], -_days, DAY ) )
Net Sales vs Prev % = DIVIDE ( [Net Sales] - [Net Sales Prev Period], [Net Sales Prev Period] )

Profit Prev Period =
VAR _days = DATEDIFF ( MIN ( dim_date[Date] ), MAX ( dim_date[Date] ), DAY ) + 1
RETURN CALCULATE ( [Profit], DATEADD ( dim_date[Date], -_days, DAY ) )
Profit vs Prev % = DIVIDE ( [Profit] - [Profit Prev Period], [Profit Prev Period] )

Orders Prev Period =
VAR _days = DATEDIFF ( MIN ( dim_date[Date] ), MAX ( dim_date[Date] ), DAY ) + 1
RETURN CALCULATE ( [Total Orders], DATEADD ( dim_date[Date], -_days, DAY ) )
Orders vs Prev % = DIVIDE ( [Total Orders] - [Orders Prev Period], [Orders Prev Period] )

Margin vs Prev (pts) =
VAR _days = DATEDIFF ( MIN ( dim_date[Date] ), MAX ( dim_date[Date] ), DAY ) + 1
VAR _prev = CALCULATE ( [Profit Margin %], DATEADD ( dim_date[Date], -_days, DAY ) )
RETURN ( [Profit Margin %] - _prev ) * 100

// ---------- FORMATTING HELPERS ----------
Arrow Text = IF ( [Net Sales vs Prev %] >= 0, "▲ ", "▼ " ) & FORMAT ( ABS ( [Net Sales vs Prev %] ), "0.0%" ) & " vs prev. period"
Growth Color = IF ( [Net Sales MoM %] >= 0, "#22D3A6", "#FF5C7A" )   // use in Conditional formatting -> Field value
Profit Color = IF ( [Profit] >= 0, "#22D3A6", "#FF5C7A" )

// ---------- RANKING / PRODUCT ----------
Product Sales Rank = RANKX ( ALL ( dim_product[ProductName] ), [Net Sales], , DESC )
Top 10 Flag = IF ( [Product Sales Rank] <= 10, 1, 0 )          // visual filter: Top 10 Flag = 1
Margin Gap vs Avg (pts) =
( [Profit Margin %] - CALCULATE ( [Profit Margin %], ALL ( dim_product ) ) ) * 100
Problem Product Flag =                                         // high sales but margin below average
IF ( [Net Sales] > CALCULATE ( AVERAGEX ( ALL ( dim_product[ProductName] ), [Net Sales] ), ALL ( dim_product ) )
     && [Margin Gap vs Avg (pts)] < 0, "⚠ High sales / low margin", "OK" )

// ---------- DYNAMIC STORY TEXT (cards that update with filters) ----------
Best Month = 
VAR _t = ADDCOLUMNS ( VALUES ( dim_date[YearMonth] ), "@s", [Net Sales] )
RETURN MAXX ( TOPN ( 1, _t, [@s], DESC ), dim_date[YearMonth] )

Top Category =
VAR _t = ADDCOLUMNS ( VALUES ( dim_product[Category] ), "@s", [Net Sales] )
RETURN MAXX ( TOPN ( 1, _t, [@s], DESC ), dim_product[Category] )

Lowest Margin Category =
VAR _t = ADDCOLUMNS ( VALUES ( dim_product[Category] ), "@m", [Profit Margin %] )
RETURN MAXX ( TOPN ( 1, _t, [@m], ASC ), dim_product[Category] )

Finding 1 = "Net sales " & FORMAT ( [Net Sales], "#,0" ) & " from " & FORMAT ( [Total Orders], "#,0" ) & " valid orders; AOV " & FORMAT ( [Average Order Value], "0.00" )
Finding 2 = "Orders " & FORMAT ( [Orders vs Prev %], "+0.0%;-0.0%" ) & " vs previous period while AOV is " & FORMAT ( [Average Order Value], "0.00" ) & " -> " &
            IF ( [Orders vs Prev %] < -0.05, "volume problem, not price problem", "volume is stable" )
Finding 3 = [Top Category] & " is the largest category; lowest margin: " & [Lowest Margin Category] & " (" & FORMAT ( CALCULATE ( [Profit Margin %], dim_product[Category] = [Lowest Margin Category] ), "0.0%" ) & ")"
